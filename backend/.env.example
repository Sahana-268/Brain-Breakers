# Brain Breakers Academy – Environment Variables
# Copy this file to .env and fill in your values

# Application
APP_NAME="Brain Breakers Academy"
APP_VERSION="1.0.0"
DEBUG=true
FRONTEND_URL="http://localhost:5173"

# Security
SECRET_KEY="change-this-to-a-long-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL="sqlite:///./brainbreakers.db"

# Admin Bootstrap (first run)
FIRST_ADMIN_EMAIL="admin@brainbreakers.com"
FIRST_ADMIN_PASSWORD="Admin@1234"
FIRST_ADMIN_NAME="System Admin"

